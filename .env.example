# Slack Bot Configuration
# Get these from https://api.slack.com/apps

# Bot's OAuth token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing secret for verifying Slack requests
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-level token for Socket Mode (only needed if USE_SOCKET_MODE=true)
# Get from: Settings > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token-here

# Internal notification bridge used by htdocs slack_processor_cli.php
CONNECTBOT_INTERNAL_API_TOKEN=replace-with-a-long-random-shared-secret
ENABLE_NOTIFICATION_BRIDGE=true
NOTIFICATION_SERVER_HOST=0.0.0.0
NOTIFICATION_SERVER_PORT=3010

# Map old htdocs webhook keys to Slack channel IDs or names the bot can post to.
SLACK_NOTIFY_CHANNEL_DEFAULT=#all-iwt
SLACK_NOTIFY_CHANNEL_EQUIPMENT=#equipment
SLACK_NOTIFY_CHANNEL_LIVEWIRE=#livewire
SLACK_NOTIFY_CHANNEL_HEADING=#heading
SLACK_NOTIFY_CHANNEL_MARKETPLACE=#marketplace
SLACK_NOTIFY_CHANNEL_ORDERS=#marketplace
SLACK_NOTIFY_CHANNEL_OPS=#all-iwt
SLACK_NOTIFY_CHANNEL_SECONDARY=#secondary

# Public WooCommerce webhook integration.
# Point WooCommerce Delivery URL at /webhooks/woocommerce on this service.
WOOCOMMERCE_WEBHOOK_SECRET=replace-with-your-woocommerce-webhook-secret
WOOCOMMERCE_ORDER_ADMIN_URL_TEMPLATE=https://your-wordpress-site/wp-admin/post.php?post=%d&action=edit

# Connect FastAPI Server Configuration
# URL of your FastAPI server (local or remote Linux VM)
FASTAPI_BASE_URL=http://localhost:8100

# API key for FastAPI authentication
FASTAPI_API_KEY=your-api-key-here

# FastAPI connection reliability tuning
FASTAPI_TIMEOUT_SECONDS=10
FASTAPI_MAX_RETRIES=2
FASTAPI_RETRY_BACKOFF_SECONDS=0.5

# OpenRouter Configuration
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Ordered fallback list. The bot will try models left-to-right.
# Free-tier models usually end with :free.
OPENROUTER_MODELS=openai/gpt-oss-120b:free,google/gemma-3-27b-it:free,openai/gpt-oss-20b:free

# Optional single-model fallback for older configs.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional metadata recommended by OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-site-or-internal-doc-url
OPENROUTER_SITE_NAME=Connect Bot

# LLM provider selection
# openrouter: existing cloud path
# ollama: local model runtime
LLM_PROVIDER=openrouter

# Local Ollama runtime settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Shared LLM timeout for provider calls
LLM_TIMEOUT_SECONDS=30

# Personality and brand voice (applies to both local Ollama and OpenRouter providers)
BOT_IDENTITY_NAME=ConnectBot
BOT_SCOPE_NAME=IWT / Connect operations
BOT_VOICE_STYLE=concise, practical, direct, and shop-floor friendly
# Optional extra instructions, e.g. "Prioritize production impact and mention machine context when useful"
BOT_PERSONALITY_NOTES=
# If true, common social prompts (hello/thanks/help/identity) use deterministic branded replies
SOCIAL_DETERMINISTIC_MODE=true

# If true and provider is ollama, bot will not fall back to external providers
LOCAL_ONLY_FAIL_CLOSED=false

# AI-first orchestration
USE_AGENT_MODE=true
AGENT_HISTORY_WINDOW=6

# Multi-endpoint tool-calling router for business questions the keyword rules
# don't catch (combines several FastAPI calls in one answer). OpenRouter only;
# it switches itself off under Ollama. false = legacy single-endpoint parser.
USE_TOOL_ROUTER=true

# Restrict sales/quote dollar figures to these Slack member IDs (comma-separated).
# Empty = everyone. Find an ID: Slack profile -> three-dot menu -> "Copy member ID".
# Equipment units, backlog, heading, and wire data stay open to all users.
SALES_ACCESS_USERS=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/connectbot.log

# Server Configuration
# Choose: true for Socket Mode (local development), false for HTTP (production)
USE_SOCKET_MODE=true

# HTTP Server Configuration (used when USE_SOCKET_MODE=false)
SERVER_PORT=3000

# HTTPS Certificate paths (optional, required for production HTTP mode)
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_KEY_FILE=/path/to/key.pem
